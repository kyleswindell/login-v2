[Unit]
Description=Parasolutions Platform Queue Worker
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/platform/current
ExecStart=/usr/bin/php artisan queue:work redis --queue=default --sleep=1 --tries=3 --timeout=90
Restart=always
RestartSec=5
Environment=APP_ENV=staging

[Install]
WantedBy=multi-user.target
