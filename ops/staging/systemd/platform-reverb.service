[Unit]
Description=Parasolutions Platform Reverb Server
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/var/www/platform/current
ExecStart=/usr/bin/php artisan reverb:start --host=0.0.0.0 --port=8080
Restart=always
RestartSec=5
Environment=APP_ENV=staging

[Install]
WantedBy=multi-user.target
