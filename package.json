{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "@parasolutions/login-app-v2",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "dev:host": "vite --host 0.0.0.0",
        "dev:lan": "vite --host 192.168.50.10 --port 5173",
        "lint:docs:guardrails": "node scripts/check-docs-guardrails.mjs",
        "inventory:m0:ui:collect": "node scripts/collect-m0-ui-current-state-inventory.mjs",
        "inventory:m0:ui:review": "node scripts/review-m0-ui-current-state-inventory.mjs",
        "inventory:m0:ui:render": "node scripts/render-m0-ui-current-state-inventory.mjs",
        "inventory:m0:repository": "node scripts/generate-m0-repository-current-state-inventory.mjs",
        "lint:m0:ui-inventory": "node scripts/check-m0-ui-current-state-inventory.mjs",
        "lint:m0:repository-inventory": "node scripts/check-m0-repository-current-state-inventory.mjs",
        "local:ready": "php artisan local:ready",
        "test:browser": "playwright test",
        "test:m0:ui-inventory": "node scripts/test-m0-ui-current-state-inventory.mjs"
    },
    "devDependencies": {
        "@playwright/test": "^1.61.1",
        "@prettier/plugin-php": "^0.24.0",
        "@tailwindcss/vite": "^4.0.0",
        "axios": "^1.15.0",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.0.0",
        "prettier": "^3.9.4",
        "prettier-plugin-blade": "^3.2.2",
        "tailwindcss": "^4.0.0",
        "vite": "^8.0.0"
    },
    "dependencies": {
        "flatpickr": "4.6.13",
        "laravel-echo": "^2.3.4",
        "pusher-js": "^8.5.0",
        "sortablejs": "^1.15.7"
    }
