<?php

declare(strict_types=1);

namespace Tests\Feature\Ui\Components;

use Illuminate\Testing\TestView;
use Tests\TestCase;

final class {{ class }} extends TestCase
{
    public function test_default_render_exposes_the_required_component_contract(): void
    {
        $view = $this->renderComponent();

        $this->assertRequiredContract((string) $view);
    }

    public function test_default_slot_content_is_rendered(): void
    {
        $this->renderComponent(slot: 'Expected component content')
            ->assertSeeText('Expected component content');
    }

    public function test_supported_caller_attributes_are_forwarded_without_removing_required_contract_values(): void
    {
        $view = $this->renderComponent(
            attributes: 'class="custom-component-class" data-test-id="custom-component" aria-label="Custom component label"',
        );

        $view
            ->assertSeeHtml('custom-component-class')
            ->assertSeeHtml('data-test-id="custom-component"')
            ->assertSeeHtml('aria-label="Custom component label"');

        $this->assertRequiredContract((string) $view);
    }

    public function test_contract_identity_matches_the_component_bundle(): void
    {
        $contract = $this->contract();

        $this->assertSame(
            '{{ component }}',
            $contract['identity']['slug'] ?? null,
        );

        $this->assertSame(
            '{{ label }}',
            $contract['identity']['label'] ?? null,
        );

        $this->assertSame(
            'x-ui.{{ component }}',
            $contract['identity']['component'] ?? null,
        );
    }

    public function test_contract_source_paths_match_the_component_bundle(): void
    {
        $source = $this->contract()['source'] ?? [];

        $this->assertContains(
            '{{ bladePath }}',
            $source['blade'] ?? [],
        );

        $this->assertContains(
            '{{ cssPath }}',
            $source['css'] ?? [],
        );

        $this->assertContains(
            '{{ contractPath }}',
            $source['contract'] ?? [],
        );

        $this->assertContains(
            '{{ docsPath }}',
            $source['docs'] ?? [],
        );
    }

