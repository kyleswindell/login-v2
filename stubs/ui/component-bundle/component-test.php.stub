    /**
     * @param array<string, mixed> $data
     */
    private function renderComponent(
        string $attributes = '',
        string $slot = 'Component content',
        array $data = [],
    ): TestView {
        return $this->blade(
            sprintf(
                '<x-ui.{{ component }} %s>%s</x-ui.{{ component }}>',
                $attributes,
                $slot,
            ),
            $data,
        );
    }

    private function assertRequiredContract(string $rendered): void
    {
        $contract = $this->contract();

        foreach ($contract['class_contract']['required'] ?? [] as $class) {
            $this->assertStringContainsString(
                $class,
                $rendered,
                sprintf('Required component class [%s] was not rendered.', $class),
            );
        }

        foreach ($contract['api']['data_attributes'] ?? [] as $attribute) {
            if (($attribute['required'] ?? false) !== true) {
                continue;
            }

            $name = $attribute['name'] ?? null;

            if (! is_string($name) || $name === '') {
                self::fail('A required contract data attribute is missing its name.');
            }

            $needle = array_key_exists('value', $attribute)
                ? sprintf('%s="%s"', $name, (string) $attribute['value'])
                : $name;

            $this->assertStringContainsString(
                $needle,
                $rendered,
                sprintf('Required component data attribute [%s] was not rendered.', $name),
            );
        }
    }

    /**
     * @return array<string, mixed>
     */
    private function contract(): array
    {
        $contract = require base_path('{{ contractPath }}');

        $this->assertIsArray($contract);

        return $contract;
    }
}